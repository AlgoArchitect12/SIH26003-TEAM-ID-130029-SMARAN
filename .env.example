# Public client configuration only. Apply the server migration/RLS before enabling a build.
# Email/Google setup and callback allowlist: docs/MVP24_AUTH_CLOUD_HARDENING.md
# Google credentials belong only in the Supabase provider dashboard, never in this file.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Native Google Maps SDK keys (not EXPO_PUBLIC). Restrict Android to com.smaran.ai + signing SHA-1.
GOOGLE_MAPS_API_KEY=
# Optional iOS build: separate key restricted to the com.smaran.ai bundle identifier.
GOOGLE_MAPS_IOS_API_KEY=

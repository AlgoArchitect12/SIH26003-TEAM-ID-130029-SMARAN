{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./*"
      ],
      "@components/*": [
        "./components/*"
      ],
      "@constants/*": [
        "./constants/*"
      ],
      "@db/*": [
        "./src/db/*"
      ],
      "@services/*": [
        "./src/services/*"
      ],
      "@ai/*": [
        "./src/ai/*"
      ],
      "@types/*": [
        "./src/types/*"
      ],
      "@i18n/*": [
        "./src/i18n/*"
      ]
    }
  },
  "exclude": ["supabase/functions/online-ai/index.ts", "supabase/functions/ai-care-assistant/index.ts"],
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
